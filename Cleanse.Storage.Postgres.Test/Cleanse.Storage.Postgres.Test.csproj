<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Every store call here is awaited against a local container; threading a token through each buys noise. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.8.0" />
    <!-- Lifts the vulnerable 2024.2.0 that Testcontainers pulls in transitively. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cleanse.Core\Cleanse.Core.csproj" />
    <ProjectReference Include="..\Cleanse.Core.Test\Cleanse.Core.Test.csproj" />
    <ProjectReference Include="..\Cleanse.Storage.Postgres\Cleanse.Storage.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests build their schema from the very SQL that CDP will apply, not from the model. -->
    <Content Include="..\changelog\sql\*.sql" Link="changelog\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- And the DML role from the same script compose.yml uses to stand in for CDP's. -->
    <Content Include="..\compose\postgres\init\*.sql" Link="roles\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
