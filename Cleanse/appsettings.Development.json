{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "Auth": {
    "ApiKey": {
      "Key": "local-development-key",
      "ClientName": "local-developer"
    },
    "Jwt": {
      "Comment": "LocalStack does not implement GetWebIdentityToken, so there is no token to validate.",
      "Enabled": false
    },
    "Reset": {
      "Key": "local-development-reset-key"
    }
  },
  "Storage": {
    "Provider": "Sqlite",
    "Sqlite": {
      "DataSource": "cleanse.local.db"
    }
  },
  "Rules": {
    "Comment": "Enabled locally so POST /v1/runs/trigger actually executes. The KRDS Data Bridge is not reachable from a developer machine, so development reads a snapshot straight off disk.",
    "Enabled": true,
    "Krds": {
      "Provider": "LocalFile",
      "LocalFilePath": "A:\\tmp\\defra-krds-duckdb\\krds-db_20261019070003.sqlite"
    }
  }
}
